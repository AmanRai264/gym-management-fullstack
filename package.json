{
  "name": "gym-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "PowerFit Gym - full-stack gym management demo (Express API + Vite React dashboard)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend",
